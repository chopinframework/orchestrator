{
  "openapi": "3.0.3",
  "info": {
    "title": "HTTP Requests API",
    "description": "API for managing HTTP requests and context data",
    "version": "1.0.0"
  },
  "tags": [
    { "name": "oracle", "description": "Request context operations" },
    { "name": "sequencer", "description": "Request sequencing operations" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "description": "API key authentication with bearer token"
      }
    },
    "schemas": {}
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/api/v1/context": {
      "post": {
        "parameters": [],
        "operationId": "postApiV1Context",
        "summary": "Create a new context entry by request nonce",
        "description": "Creates a new context entry for a request identified by its nonce",
        "tags": ["oracle"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "requestNonce": {
                    "description": "Nonce of the request",
                    "type": "string"
                  },
                  "value": {
                    "description": "Context value to store",
                    "type": "string"
                  }
                },
                "required": ["requestNonce", "value"]
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "requestNonce": {
                    "description": "Nonce of the request",
                    "type": "string"
                  },
                  "value": {
                    "description": "Context value to store",
                    "type": "string"
                  }
                },
                "required": ["requestNonce", "value"]
              }
            },
            "text/plain": {
              "schema": {
                "type": "object",
                "properties": {
                  "requestNonce": {
                    "description": "Nonce of the request",
                    "type": "string"
                  },
                  "value": {
                    "description": "Context value to store",
                    "type": "string"
                  }
                },
                "required": ["requestNonce", "value"]
              }
            }
          }
        },
        "responses": { "200": {} }
      }
    },
    "/api/v1/request": {
      "post": {
        "parameters": [],
        "operationId": "postApiV1Request",
        "summary": "Sequence an HTTP request",
        "description": "Process an HTTP request through the sequencer",
        "tags": ["sequencer"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "description": "Complete URL of the request",
                    "type": "string"
                  },
                  "method": {
                    "description": "HTTP method (GET, POST, PUT, etc.)",
                    "type": "string"
                  },
                  "headers": {
                    "description": "HTTP headers",
                    "type": "object",
                    "patternProperties": { "^(.*)$": { "type": "string" } }
                  },
                  "body": {
                    "description": "The request body content",
                    "type": "string"
                  }
                },
                "required": ["url", "method", "headers", "body"]
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "description": "Complete URL of the request",
                    "type": "string"
                  },
                  "method": {
                    "description": "HTTP method (GET, POST, PUT, etc.)",
                    "type": "string"
                  },
                  "headers": {
                    "description": "HTTP headers",
                    "type": "object",
                    "patternProperties": { "^(.*)$": { "type": "string" } }
                  },
                  "body": {
                    "description": "The request body content",
                    "type": "string"
                  }
                },
                "required": ["url", "method", "headers", "body"]
              }
            },
            "text/plain": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "description": "Complete URL of the request",
                    "type": "string"
                  },
                  "method": {
                    "description": "HTTP method (GET, POST, PUT, etc.)",
                    "type": "string"
                  },
                  "headers": {
                    "description": "HTTP headers",
                    "type": "object",
                    "patternProperties": { "^(.*)$": { "type": "string" } }
                  },
                  "body": {
                    "description": "The request body content",
                    "type": "string"
                  }
                },
                "required": ["url", "method", "headers", "body"]
              }
            }
          }
        },
        "responses": { "200": {} }
      }
    }
  }
}
